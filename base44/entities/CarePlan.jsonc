{
  "name": "CarePlan",
  "type": "object",
  "properties": {
    "patient_id": {
      "type": "string"
    },
    "patient_name": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "pae_type": {
      "type": "string",
      "enum": [
        "comunitario",
        "intrahospitalario"
      ],
      "default": "intrahospitalario"
    },
    "pae_number": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "default": "01"
    },
    "code": {
      "type": "string"
    },
    "pae_date": {
      "type": "string",
      "format": "date"
    },
    "service": {
      "type": "string"
    },
    "bed_number": {
      "type": "string"
    },
    "medical_record": {
      "type": "string"
    },
    "admission_number": {
      "type": "string"
    },
    "medical_diagnosis": {
      "type": "string"
    },
    "assessment": {
      "type": "string"
    },
    "diagnoses": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nanda": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "definition": {
            "type": "string"
          },
          "related_to": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "class": {
            "type": "string"
          }
        }
      }
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "noc": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "indicators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scale_initial": {
            "type": "string"
          },
          "scale_expected": {
            "type": "string"
          }
        }
      }
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nic": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "activities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "scale_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "scale": {
            "type": "string"
          },
          "score": {
            "type": "string"
          },
          "interpretation": {
            "type": "string"
          }
        }
      }
    },
    "execution": {
      "type": "string"
    },
    "evaluation": {
      "type": "string"
    },
    "patient_education": {
      "type": "string"
    },
    "follow_up": {
      "type": "string"
    },
    "diana_score": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "borrador",
        "activo",
        "completado"
      ],
      "default": "borrador"
    },
    "ai_generated": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "patient_id",
    "patient_name",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}