{
  "name": "Course",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "lessons_count": {
      "type": "number",
      "default": 0
    },
    "duration_hours": {
      "type": "number",
      "default": 0
    },
    "level": {
      "type": "string",
      "enum": [
        "basico",
        "intermedio",
        "avanzado"
      ],
      "default": "basico"
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "certified": {
      "type": "boolean",
      "default": false
    },
    "instructor": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "publicado",
        "borrador"
      ],
      "default": "publicado"
    }
  },
  "required": [
    "title",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}