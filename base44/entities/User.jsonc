{
  "name": "User",
  "type": "object",
  "properties": {
    "professional_role": {
      "type": "string",
      "enum": [
        "enfermero",
        "docente",
        "estudiante",
        "institucion",
        "administrador"
      ],
      "default": "enfermero"
    },
    "license_number": {
      "type": "string"
    },
    "institution_name": {
      "type": "string"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "gratuito",
        "premium",
        "universidades",
        "hospitales"
      ],
      "default": "gratuito"
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false
    }
  }
}