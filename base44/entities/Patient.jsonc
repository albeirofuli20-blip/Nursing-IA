{
  "name": "Patient",
  "type": "object",
  "properties": {
    "code": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "birth_date": {
      "type": "string",
      "format": "date"
    },
    "sex": {
      "type": "string",
      "enum": [
        "femenino",
        "masculino",
        "otro",
        "no_especificado"
      ]
    },
    "clinical_summary": {
      "type": "string"
    },
    "allergies": {
      "type": "string"
    },
    "current_medications": {
      "type": "string"
    }
  },
  "required": [
    "code",
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}