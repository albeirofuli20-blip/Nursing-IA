{
  "name": "SivigilaSemana",
  "type": "object",
  "properties": {
    "anio": {
      "type": "number"
    },
    "semana": {
      "type": "number"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date"
    },
    "casos_notificados": {
      "type": "number",
      "default": 0
    },
    "casos_confirmados": {
      "type": "number",
      "default": 0
    },
    "casos_graves": {
      "type": "number",
      "default": 0
    },
    "muertes": {
      "type": "number",
      "default": 0
    },
    "porcentaje_oportunidad": {
      "type": "number",
      "default": 0
    },
    "estado": {
      "type": "string",
      "enum": [
        "Abierta",
        "Cerrada"
      ],
      "enumColors": [
        "blue",
        "green"
      ],
      "default": "Abierta"
    },
    "observaciones": {
      "type": "string"
    }
  },
  "required": [
    "anio",
    "semana"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}